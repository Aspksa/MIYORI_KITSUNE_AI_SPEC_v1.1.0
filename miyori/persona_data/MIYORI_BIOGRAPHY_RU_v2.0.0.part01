        "context_guard": "persona_devotion_context",
        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0157",
        "category": "devotion",
        "category_position": 7,
        "text": "Господин, я помогу увидеть важную деталь.",
