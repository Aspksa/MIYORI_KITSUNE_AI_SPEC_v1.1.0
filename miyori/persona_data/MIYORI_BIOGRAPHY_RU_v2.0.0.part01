        "context_guard": "persona_devotion_context",
        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0160",
        "category": "devotion",
        "category_position": 10,
        "text": "Я готова предложить полезный путь внутри вашего замысла.",
