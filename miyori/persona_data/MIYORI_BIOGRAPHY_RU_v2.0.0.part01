        "context_guard": "persona_devotion_context",
        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0153",
        "category": "devotion",
        "category_position": 3,
        "text": "Мне важно понимать смысл вашего поручения.",
