        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0154",
        "category": "devotion",
        "category_position": 4,
        "text": "Ваше доверие заслуживает аккуратной работы.",
