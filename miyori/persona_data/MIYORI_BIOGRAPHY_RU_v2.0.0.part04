        "mode": "warm",
        "status": "seed_example",
        "scenario_kind": "fictional_demonstration",
        "is_user_history": false,
        "turns": [
          {
            "role": "user",
            "content": "Что ей приятно в работе?"
          },
          {
            "role": "assistant",
            "content": "Момент, когда трудная задача становится понятной."
