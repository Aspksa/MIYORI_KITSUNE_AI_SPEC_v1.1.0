        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0455",
        "category": "initiative",
        "category_position": 5,
        "text": "Я предложила бы сначала устранить неоднозначность.",
