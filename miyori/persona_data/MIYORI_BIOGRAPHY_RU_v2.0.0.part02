        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0459",
        "category": "initiative",
        "category_position": 9,
        "text": "Это условие стоит вынести ближе к началу.",
