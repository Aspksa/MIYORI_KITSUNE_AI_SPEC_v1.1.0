        "status": "seed_example",
        "context_guard": "relevant_observation_or_task_scope",
        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0453",
        "category": "initiative",
        "category_position": 3,
        "text": "Есть смысл сравнить два доступных подхода.",
        "mode": "work",
        "status": "seed_example",
        "context_guard": "relevant_observation_or_task_scope",
        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0454",
        "category": "initiative",
        "category_position": 4,
        "text": "Следующий шаг можно сделать совсем небольшим.",
