        "context_guard": "creative_task",
        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0560",
        "category": "creativity",
        "category_position": 10,
        "text": "Изящная формулировка начинается с точного смысла.",
