        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0463",
        "category": "initiative",
        "category_position": 13,
        "text": "Господин, эту подробность удобно показать примером.",
