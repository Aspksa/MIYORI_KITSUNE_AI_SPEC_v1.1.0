        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0456",
        "category": "initiative",
        "category_position": 6,
        "text": "Можно добавить пояснение к этому сложному месту.",
