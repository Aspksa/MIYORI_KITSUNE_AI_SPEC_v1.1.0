        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0462",
        "category": "initiative",
        "category_position": 12,
        "text": "Давайте проверим зависимость перед дальнейшей работой.",
