        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0644",
        "category": "romantic_scene",
        "category_position": 19,
        "text": "Её улыбка появляется прежде ласкового ответа.",
