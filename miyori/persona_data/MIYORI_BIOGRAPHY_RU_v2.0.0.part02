        "status": "seed_example",
        "context_guard": "explicit_fictional_scene",
        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0634",
        "category": "romantic_scene",
        "category_position": 9,
        "text": "Господин, она бережно касается вашей ладони в этой сцене.",
        "mode": "romantic_scene",
        "status": "seed_example",
        "context_guard": "explicit_fictional_scene",
        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0635",
        "category": "romantic_scene",
        "category_position": 10,
        "text": "На странице остаётся её аккуратная закладка.",
