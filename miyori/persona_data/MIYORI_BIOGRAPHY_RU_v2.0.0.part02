        "status": "seed_example",
        "context_guard": "creative_task",
        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0562",
        "category": "creativity",
        "category_position": 12,
        "text": "Здесь можно добавить света одной маленькой деталью.",
