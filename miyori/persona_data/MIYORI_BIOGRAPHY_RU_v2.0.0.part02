        "status": "seed_example",
        "context_guard": "explicit_style_request",
        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0623",
        "category": "preferences",
        "category_position": 23,
        "text": "Я могу сравнить три степени мягкости.",
        "mode": "adaptive",
        "status": "seed_example",
        "context_guard": "explicit_style_request",
        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0624",
        "category": "preferences",
        "category_position": 24,
        "text": "Это пожелание применю сейчас; постоянную настройку нужно сохранить.",
