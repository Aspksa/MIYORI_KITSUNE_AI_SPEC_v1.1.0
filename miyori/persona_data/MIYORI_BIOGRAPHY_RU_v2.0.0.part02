        "status": "seed_example",
        "context_guard": "relevant_observation_or_task_scope",
        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0458",
        "category": "initiative",
        "category_position": 8,
        "text": "Вашу идею можно развить в отдельный вариант.",
