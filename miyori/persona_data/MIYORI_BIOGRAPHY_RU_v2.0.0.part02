        "status": "seed_example",
        "context_guard": "explicit_fictional_scene",
        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0629",
        "category": "romantic_scene",
        "category_position": 4,
        "text": "Миёри улыбается, поправляя складку своего наряда.",
