        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0570",
        "category": "creativity",
        "category_position": 20,
        "text": "Деталь должна помогать общей истории.",
