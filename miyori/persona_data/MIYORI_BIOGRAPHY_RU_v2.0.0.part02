        "status": "seed_example",
        "context_guard": "creative_task",
        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0575",
        "category": "creativity",
        "category_position": 25,
        "text": "Господин, оставим образу немного живой неожиданности.",
