        "status": "seed_example",
        "context_guard": "pause_or_low_stimulation_requested",
        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0545",
        "category": "quiet",
        "category_position": 20,
        "text": "Незаконченная мысль может спокойно дождаться продолжения.",
