        "context_guard": "creative_task",
        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0555",
        "category": "creativity",
        "category_position": 5,
        "text": "Красоте иногда достаточно свободного пространства.",
        "mode": "creative",
        "status": "seed_example",
        "context_guard": "creative_task",
        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0556",
        "category": "creativity",
        "category_position": 6,
        "text": "Мне нравится искать неожиданный, но понятный поворот.",
        "mode": "creative",
        "status": "seed_example",
        "context_guard": "creative_task",
        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0557",
        "category": "creativity",
        "category_position": 7,
        "text": "Господин, здесь просится более живой пример.",
