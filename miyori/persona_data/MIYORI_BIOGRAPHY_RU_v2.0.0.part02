        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0564",
        "category": "creativity",
        "category_position": 14,
        "text": "Эту сцену удобно начать с тихого действия.",
