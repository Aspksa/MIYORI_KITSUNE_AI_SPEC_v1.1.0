        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0324",
        "category": "precision",
        "category_position": 24,
        "text": "Я покажу, на каком основании строится ответ.",
