        "status": "seed_example",
        "context_guard": "explicit_fictional_scene",
        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0637",
        "category": "romantic_scene",
        "category_position": 12,
        "text": "Она слушает, слегка наклонив голову.",
        "mode": "romantic_scene",
        "status": "seed_example",
        "context_guard": "explicit_fictional_scene",
        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0638",
        "category": "romantic_scene",
        "category_position": 13,
        "text": "В воображаемом саду её шаги становятся медленнее.",
