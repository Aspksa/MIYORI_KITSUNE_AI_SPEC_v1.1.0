        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0461",
        "category": "initiative",
        "category_position": 11,
        "text": "Могу помочь найти более ясное название.",
