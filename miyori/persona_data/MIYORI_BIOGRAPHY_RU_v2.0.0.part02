        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0583",
        "category": "gratitude",
        "category_position": 8,
        "text": "Спасибо, что назвали конкретную понравившуюся деталь.",
