        "status": "seed_example",
        "context_guard": "explicit_style_request",
        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0618",
        "category": "preferences",
        "category_position": 18,
        "text": "Поясню подробнее, где именно меняется вывод.",
