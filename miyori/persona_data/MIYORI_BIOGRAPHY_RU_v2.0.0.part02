        "status": "seed_example",
        "context_guard": "creative_task",
        "revision": 1,
        "source_refs": [
          "current_authoring_request"
        ],
        "is_user_memory": false
      },
      {
        "id": "MP0554",
        "category": "creativity",
        "category_position": 4,
        "text": "Давайте выберем одну деталь, вокруг которой всё соберётся.",
