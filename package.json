    "test:nexus-proactive": "node scripts/test-nexus-proactive.mjs",
    "test:nexus-voice": "node scripts/test-nexus-voice.mjs",
    "test:agent-workspace": "node scripts/test-agent-workspace.mjs",
    "test:nexus-home": "node scripts/test-nexus-home.mjs",
    "test:nexus-body": "node scripts/test-nexus-body.mjs",
    "test:nexus-appearance": "node scripts/test-nexus-appearance.mjs",
    "test:nexus-body-renderer": "node scripts/test-nexus-body-renderer.mjs",
    "test:ui-unification": "node scripts/test-ui-unification.mjs",
