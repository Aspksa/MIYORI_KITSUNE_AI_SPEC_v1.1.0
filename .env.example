# Copy this file to .env and fill in your Cloud.ru settings.
CLOUDRU_API_KEY=
CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1
CLOUDRU_MODEL_ID=deepseek-ai/DeepSeek-V4-Flash
# Optional published tariffs: RUB per 1 million input/output tokens.
# Unset or 0 = unknown cost, never a claimed free model.
CLOUDRU_INPUT_RUB_PER_1M_TOKENS=0
CLOUDRU_OUTPUT_RUB_PER_1M_TOKENS=0

# Optional
MIYORI_HOST=127.0.0.1
MIYORI_PORT=8765
MIYORI_OPEN_BROWSER=1

# Project updates
MIYORI_AUTO_UPDATE=1
MIYORI_UPDATE_BRANCH=main
MIYORI_UPDATE_INTERVAL_MINUTES=15
